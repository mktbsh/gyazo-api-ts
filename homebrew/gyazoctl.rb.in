class Gyazoctl < Formula
  desc "Command-line client for the Gyazo API"
  homepage "https://github.com/mktbsh/gyazo-api-sdk"
  license "MIT"

  depends_on macos: :ventura

  on_macos do
    on_arm do
      url "https://github.com/mktbsh/gyazo-api-sdk/releases/download/v__VERSION__/gyazoctl-darwin-arm64.tar.gz"
      sha256 "__ARM64_SHA256__"
    end

    on_intel do
      url "https://github.com/mktbsh/gyazo-api-sdk/releases/download/v__VERSION__/gyazoctl-darwin-x64.tar.gz"
      sha256 "__X64_SHA256__"
    end
  end

  def install
    bin.install "gyazoctl"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/gyazoctl --version")
  end
end
