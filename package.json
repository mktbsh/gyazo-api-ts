{
  "name": "gyazo-api-sdk-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm --recursive run build",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build",
    "format": "biome check . --write",
    "lint": "biome check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.7",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "publint": "0.3.23",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
