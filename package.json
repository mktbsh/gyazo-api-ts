{
  "name": "@mktbsh/gyazo-api",
  "version": "0.1.1",
  "private": false,
  "description": "A type-safe, zero-dependency Gyazo API client for TypeScript",
  "type": "module",
  "license": "MIT",
  "author": "mktbsh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mktbsh/gyazo-api-ts.git"
  },
  "homepage": "https://github.com/mktbsh/gyazo-api-ts#readme",
  "bugs": {
    "url": "https://github.com/mktbsh/gyazo-api-ts/issues"
  },
  "keywords": [
    "gyazo",
    "api",
    "client",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:consumer": "node scripts/test-tarball.mjs",
    "pack:lint": "bun run build && node scripts/check-package.mjs",
    "changeset": "bunx --bun @changesets/cli@2.30.0",
    "version-packages": "bunx --bun @changesets/cli@2.30.0 version",
    "release": "bunx --bun @changesets/cli@2.30.0 publish",
    "check": "bun run lint && bun run typecheck && bun run test:coverage && bun run build && bun run pack:lint && bun run test:consumer",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "publint": "^0.3.21",
    "tsdown": "^0.22.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
